            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert exam started" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename" />
              <stringProp name="parameters" />
              <stringProp name="script">import groovy.json.JsonSlurper
try {
  def root = new JsonSlurper().parseText(prev.getResponseDataAsString())
  if (prev.getResponseCode() != '200') {
    AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Start HTTP ' + prev.getResponseCode())
  } else if (root.code != 0) {
    AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Start API error: ' + root.message)
  } else if (!root.data?.attemptId || !(root.data?.questions?.size() &gt; 0)) {
    AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Attempt ID or question snapshot missing')
  }
} catch (Throwable ex) {
  AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Start response parse error: ' + ex.toString())
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
            <hashTree />
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract attempt and build answer list" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename" />
              <stringProp name="parameters" />
              <stringProp name="script">import groovy.json.JsonSlurper
try {
  def root = new JsonSlurper().parseText(prev.getResponseDataAsString())
  def d = root?.data
  def qs = (root?.code == 0 &amp;&amp; d != null) ? (d.questions ?: []) : []
  vars.put('attemptId', d?.attemptId?.toString() ?: '')
  vars.put('qCount', qs.size().toString())
  vars.put('qIndex', '0')
  qs.eachWithIndex { q, i -&gt;
    String type = (q.type ?: '').toString()
    def opts = q.options ?: []
    String ans
    if (type in ['SINGLE','JUDGE','MULTIPLE']) {
      String first = opts ? opts[0].toString() : 'A'
      int dot = first.indexOf('.')
      ans = dot &gt; 0 ? first.substring(0, dot).trim() : first.trim()
    } else if (type == 'FILL') {
      ans = 'JMeter自动化压测答案'
    } else {
      ans = 'JMeter automated subjective test answer.'
    }
    vars.put('qid_' + i, q.questionId.toString())
    vars.put('answer_' + i, ans)
  }
} catch (Exception ex) {
  vars.put('attemptId', '')
  vars.put('qCount', '0')
  vars.put('qIndex', '0')
  log.warn('Unable to parse start-exam response', ex)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree />
          </hashTree>
