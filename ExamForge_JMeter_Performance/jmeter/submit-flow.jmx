              <stringProp name="script">import groovy.json.JsonSlurper
try {
  def root = new JsonSlurper().parseText(prev.getResponseDataAsString())
  if (prev.getResponseCode() != '200') {
    AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Attempt verify HTTP ' + prev.getResponseCode())
  } else if (root.code != 0) {
    AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Attempt verify API error: ' + root.message)
  } else if (root.data?.status != 'SUBMITTED') {
    AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Attempt status is ' + root.data?.status)
  }
} catch (Throwable ex) {
  AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Attempt verify response parse error: ' + ex.toString())
}</stringProp>
