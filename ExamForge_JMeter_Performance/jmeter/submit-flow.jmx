          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert target exam is available" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename" />
            <stringProp name="parameters" />
            <stringProp name="script">import groovy.json.JsonSlurper
try {
  def root = new JsonSlurper().parseText(prev.getResponseDataAsString())
  def target = vars.get('examId') as Long
  if (prev.getResponseCode() != '200') {
    AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Browse HTTP ' + prev.getResponseCode())
  } else if (root.code != 0) {
    AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Browse API error: ' + root.message)
  } else if (!(root.data ?: []).any { (it.id as Long) == target }) {
    AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Exam ' + target + ' is not currently available to candidates')
  }
} catch (Throwable ex) {
  AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Browse response parse error: ' + ex.toString())
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
