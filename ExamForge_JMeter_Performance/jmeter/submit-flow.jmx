              <hashTree />
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build answer request for current question" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename" />
                <stringProp name="parameters" />
                <stringProp name="script">import groovy.json.JsonOutput
int i = (vars.get('qIndex') ?: '0') as int

// Stagger only the first answer request for each candidate.
// All candidates still reach the global barrier together, but their first
// save-answer requests are spread over a configurable random window.
if (i == 0) {
  long maxJitterMs = (props.get('answerStartJitterMs') ?: '30000') as long
  if (maxJitterMs > 0L) {
    long delayMs = java.util.concurrent.ThreadLocalRandom.current().nextLong(maxJitterMs + 1L)
    if (delayMs > 0L) {
      Thread.sleep(delayMs)
    }
  }
}

String qid = vars.get('qid_' + i)
String answer = vars.get('answer_' + i) ?: ''
if (!qid) { throw new IllegalStateException('Question id missing at index ' + i) }
vars.put('requestBody', JsonOutput.toJson([questionId: (qid as Long), answer: answer, version: 0]))
vars.put('qIndex', (i + 1).toString())</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PreProcessor>
              <hashTree />
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert answer saved" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename" />
                <stringProp name="parameters" />
                <stringProp name="script">import groovy.json.JsonSlurper
try {
  // A connection refusal has a non-numeric JMeter response code and no JSON body.
  if (!(prev.getResponseCode() ==~ /\d{3}/)) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Save answer transport failure: ' + prev.getResponseCode() + ' | ' + prev.getResponseMessage())
  } else {
    def root = new JsonSlurper().parseText(prev.getResponseDataAsString())
    if (prev.getResponseCode() != '200') {
      AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Save answer HTTP ' + prev.getResponseCode())
    } else if (root.code != 0) {
      AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Save answer API error: ' + root.message)
    }
  }
} catch (Throwable ex) {
  AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Save answer response parse error: ' + ex.toString())
}</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223Assertion>
