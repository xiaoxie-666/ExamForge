          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="03 Start exam" enabled="true">
            <stringProp name="HTTPSampler.domain">${__P(host,127.0.0.1)}</stringProp>
