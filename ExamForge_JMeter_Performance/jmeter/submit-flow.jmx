          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert login success" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename" />
            <stringProp name="parameters" />
            <stringProp name="script">import groovy.json.JsonSlurper
try {
  def root = new JsonSlurper().parseText(prev.getResponseDataAsString())
  if (prev.getResponseCode() != '200') {
    AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Login HTTP ' + prev.getResponseCode())
  } else if (root.code != 0) {
    AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Login API error: ' + root.message)
  } else if (!root.data?.token) {
    AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Login token missing')
  }
} catch (Throwable ex) {
  AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Login response parse error: ' + ex.toString())
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
