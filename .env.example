# Copy this file to .env and replace every change-me value before starting Docker Compose.
MYSQL_ROOT_PASSWORD=change-me-root-password
# The supplied SQL bootstrap scripts use this schema name; keep it as examforge.
MYSQL_DATABASE=examforge
MYSQL_USER=examforge
MYSQL_PASSWORD=change-me-app-password

# Use a cryptographically random value with at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

ROCKETMQ_NAME_SERVER=namesrv:9876
XXL_JOB_ADMIN_URL=http://xxl-admin:8080/xxl-job-admin
XXL_JOB_TOKEN=change-me-xxl-job-token

# Keep false for a normal demo deployment. The preparation script enables
# load-test account provisioning only for its own Compose startup command.
LOADTEST_USERS_ENABLED=false
LOADTEST_USER_START=1001
LOADTEST_USER_COUNT=1000
LOADTEST_USER_PASSWORD=Loadtest@123
